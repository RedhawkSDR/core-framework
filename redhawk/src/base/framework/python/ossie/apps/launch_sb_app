USAGE="""\
usage: %prog <domain mgr IOR> <sad file> <app name>
"""

from ossie.utils import sb
from ossie.cf import CF
import os, time

if __name__ == '__main__':
    # Grab command line arguments and options
    import sys
    from optparse import OptionParser

    parser = OptionParser(usage=USAGE)

    options, args = parser.parse_args()

    try:
        domain_ior = args[0]
    except IndexError:
        parser.error("no domain IOR provided")

    try:
        sad_filename = args[1]
    except IndexError:
        parser.error("no sad file name provided (must be relative to SDRROOT)")

    try:
        app_name = args[2]
    except IndexError:
        parser.error("no app name provided")

    try:
        naming_context_ior = args[3]
    except IndexError:
        parser.error("no app naming context provided")

    try:
        waveform_context_name = args[4]
    except IndexError:
        parser.error("no app naming context provided")
    
    domain_ref = None
    try:
        domain_ref = sb.orb.string_to_object(domain_ior)
    except:
        pass
    
    try:
        app = sb.launchLocalSADFile(sad_filename, {}, domain_ref, app_name, naming_context_ior, waveform_context_name)
    except Exception as e:
        print(e)
        # app = sb.domainless.LocalApplicationStub()
        # app._LocalApplicationStub_components = []
        # domain_ref.registerComponent(app_name, app._this())

    while True:
        time.sleep(1)
